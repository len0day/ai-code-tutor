"use client";

import Link from "next/link";
import { usePathname, useRouter } from "next/navigation";
import { useEffect, useState } from "react";
import { COURSES } from "@/data/courses";
import { logout, useMe } from "@/lib/useMe";

export default function Nav() {
  const pathname = usePathname();
  const router = useRouter();
  const me = useMe();
  const [status, setStatus] = useState<SettingsStatus | null>(null);

  useEffect(() => {
    let alive = true;
    // 管理员才需要设置页的配置状态点
    fetch("/api/auth/me")
      .then((r) => r.json())
      .then((d) => {
        if (!alive || !d.user || d.user.role !== "admin") return;
        return fetch("/api/settings")
          .then((r) => r.json())
          .then((s) => alive && setStatus(s))
          .catch(() => {});
      })
      .catch(() => {});
    return () => {
      alive = false;
    };
  }, [pathname]);

  const isAdmin = me?.role === "admin";

  const link = (href: string, label: string) => (
    <Link
      href={href}
      className={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
        pathname === href
          ? "bg-indigo-50 text-indigo-600"
          : "text-slate-600 hover:text-slate-900 hover:bg-slate-100"
      }`}
    >
      {label}
    </Link>
  );

  const handleLogout = async () => {
    await logout();
    router.replace("/login");
    router.refresh();
  };

  return (
    <header className="sticky top-0 z-40 backdrop-blur bg-white/80 border-b border-border">
      <div className="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between gap-2">
        <Link href="/" className="flex items-center gap-2 font-bold text-lg shrink-0">
          <span className="text-xl">⚡</span>
          <span>
            CodeTutor <span className="text-indigo-600">AI</span>
          </span>
        </Link>
        <nav className="flex items-center gap-1 overflow-x-auto">
          {link("/", "首页")}
          <details className="relative">
            <summary
              className={`list-none px-3 py-1.5 rounded-lg text-sm font-medium cursor-pointer select-none transition-colors ${
                pathname.startsWith("/learn")
                  ? "bg-indigo-50 text-indigo-600"
                  : "text-slate-600 hover:text-slate-900 hover:bg-slate-100"
              }`}
            >
              课程 ▾
            </summary>
            <div className="absolute left-0 top-full mt-1 w-48 bg-white border border-border rounded-xl shadow-lg py-1.5 z-50">
              {COURSES.map((c) => (
                <Link
                  key={c.lang}
                  href={`/learn/${c.lang}`}
                  className="flex items-center gap-2.5 px-4 py-2 text-sm text-slate-600 hover:bg-indigo-50 hover:text-indigo-600"
                >
                  <span>{c.emoji}</span>
                  {c.name}
                </Link>
              ))}
            </div>
          </details>
          {link("/notebook", "知识库")}
          {isAdmin && link("/admin", "后台")}
          {isAdmin && (
            <Link
              href="/settings"
              className={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5 ${
                pathname === "/settings"
                  ? "bg-indigo-50 text-indigo-600"
                  : "text-slate-600 hover:text-slate-900 hover:bg-slate-100"
              }`}
            >
              设置
              {status && (
                <span
                  title={status.configured ? `已配置（${status.provider}）` : "未配置 API Key"}
                  className={`w-2 h-2 rounded-full ${
                    status.configured ? "bg-emerald-500" : "bg-amber-400 animate-pulse"
                  }`}
                />
              )}
            </Link>
          )}
        </nav>

        {/* 用户区 */}
        <div className="flex items-center gap-2 shrink-0">
          {me === undefined ? null : me === null ? (
            <Link
              href="/login"
              className="text-sm font-medium bg-indigo-600 hover:bg-indigo-700 text-white px-3.5 py-1.5 rounded-lg transition-colors"
            >
              登录 / 注册
            </Link>
          ) : (
            <>
              <span
                title={me.role === "admin" ? "管理员" : "普通用户"}
                className="text-sm text-slate-600 max-w-[100px] truncate"
              >
                {me.role === "admin" ? "👑 " : "👤 "}
                {me.username}
              </span>
              <button
                onClick={handleLogout}
                className="text-xs text-slate-400 hover:text-red-500 transition-colors"
              >
                退出
              </button>
            </>
          )}
        </div>
      </div>
    </header>
  );
}

interface SettingsStatus {
  configured: boolean;
  provider: string;
}
