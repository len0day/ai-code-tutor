"use client";

import Link from "next/link";
import { useParams } from "next/navigation";
import { Suspense, useEffect, useState } from "react";
import { findLesson, getCourse, flatLessons } from "@/data/courses";
import {
  fetchNotebook,
  lessonToLcTags,
  postProgress,
  saveNote,
  streamAi,
  toggleFavorite,
} from "@/lib/client";
import { LC_LANGS } from "@/lib/ai/presets";
import type { Notebook, Progress } from "@/lib/types";
import Markdown from "@/components/Markdown";
import ChatPanel from "@/components/ChatPanel";
import QuizTab from "@/components/QuizTab";
import CodeReview from "@/components/CodeReview";
import InterviewTab from "@/components/InterviewTab";
import LeetCodeList from "@/components/LeetCodeList";
import ReasoningBlock from "@/components/ReasoningBlock";
import SpeakButton from "@/components/SpeakButton";

type Tab = "tutor" | "quiz" | "review" | "interview";

/** 课程语言 → highlight.js 语言（示例代码高亮用） */
const HL_LANG: Record<string, string> = {
  docker: "dockerfile",
  linux: "bash",
};

export default function LessonPage() {
  return (
    <Suspense fallback={<p className="text-center text-slate-400 py-20">加载课程…</p>}>
      <LessonContent />
    </Suspense>
  );
}

function LessonContent() {
  const params = useParams<{ lang: string; lessonId: string }>();
  const lang = params.lang;
  const lessonId = params.lessonId;
  const course = getCourse(lang);
  const found = findLesson(lang, lessonId);

  const [tab, setTab] = useState<Tab>("tutor");
  const [progress, setProgress] = useState<Progress | null>(null);
  const [notebook, setNotebook] = useState<Notebook | null>(null);
  const [noteDraft, setNoteDraft] = useState("");
  const [noteSavedAt, setNoteSavedAt] = useState<string | null>(null);
  const [explain, setExplain] = useState("");
  const [explainReasoning, setExplainReasoning] = useState("");
  const [explaining, setExplaining] = useState(false);
  const [explainError, setExplainError] = useState("");
  const [justCompleted, setJustCompleted] = useState(false);

  // 记录访问（异步回调中更新状态）
  useEffect(() => {
    if (findLesson(lang, lessonId)) {
      postProgress({ type: "visit", lessonId }).then(setProgress).catch(() => {});
    }
  }, [lang, lessonId]);

  // 拉取知识库（收藏/笔记状态）
  useEffect(() => {
    fetchNotebook()
      .then((nb) => {
        setNotebook(nb);
        setNoteDraft(nb.notes[lessonId]?.content ?? "");
      })
      .catch(() => {});
  }, [lessonId]);

  // 切换课时清空讲解与完成提示（渲染期调整状态）
  const [prevKey, setPrevKey] = useState(lessonId);
  if (prevKey !== lessonId) {
    setPrevKey(lessonId);
    setExplain("");
    setExplainReasoning("");
    setExplaining(false);
    setExplainError("");
    setJustCompleted(false);
    setNoteSavedAt(null);
  }

  if (!course || !found) {
    return (
      <div className="text-center py-20">
        <p className="text-slate-500">未找到课程内容</p>
        <Link href="/" className="text-indigo-600 mt-4 inline-block">
          返回首页
        </Link>
      </div>
    );
  }

  const { lesson, level, index, total } = found;
  const flat = flatLessons(lang);
  const prev = index > 0 ? flat[index - 1].lesson : null;
  const next = index < total - 1 ? flat[index + 1].lesson : null;
  const completed = progress?.lessons[lessonId]?.completed ?? false;

  const markComplete = async () => {
    const p = await postProgress({ type: "complete", lessonId });
    setProgress(p);
    setJustCompleted(true);
  };

  const lessonFav = notebook?.favorites.some(
    (f) => f.kind === "lesson" && f.lessonId === lessonId
  );

  const toggleLessonFav = async () => {
    await toggleFavorite({
      lessonId,
      lang,
      kind: "lesson",
      title: lesson.title,
      content: lesson.summary,
    });
    setNotebook(await fetchNotebook());
  };

  const isKeyPointFav = (kp: string) =>
    notebook?.favorites.some(
      (f) => f.kind === "keypoint" && f.lessonId === lessonId && f.title === kp
    );

  const toggleKeyPointFav = async (kp: string) => {
    await toggleFavorite({
      lessonId,
      lang,
      kind: "keypoint",
      title: kp,
      content: `《${lesson.title}》的知识点`,
    });
    setNotebook(await fetchNotebook());
  };

  const handleSaveNote = async () => {
    await saveNote(lessonId, lang, noteDraft);
    setNotebook(await fetchNotebook());
    setNoteSavedAt(new Date().toLocaleTimeString("zh-CN", { hour: "2-digit", minute: "2-digit" }));
  };

  const deepExplain = async (force = false) => {
    if (explaining) return;
    setExplain("");
    setExplainReasoning("");
    setExplainError("");
    setExplaining(true);
    try {
      await streamAi(
        { task: "explain", lang, lessonId, force },
        {
          onContent: (delta) => setExplain((prev) => prev + delta),
          onReasoning: (delta) => setExplainReasoning((prev) => prev + delta),
        }
      );
    } catch (e) {
      setExplainError(e instanceof Error ? e.message : "讲解失败");
    } finally {
      setExplaining(false);
    }
  };

  const tabBtn = (id: Tab, label: string) => (
    <button
      onClick={() => setTab(id)}
      className={`flex-1 py-2.5 text-sm font-medium transition-colors border-b-2 ${
        tab === id
          ? "border-indigo-600 text-indigo-600 bg-indigo-50/50"
          : "border-transparent text-slate-500 hover:text-slate-800"
      }`}
    >
      {label}
    </button>
  );

  return (
    <div className="space-y-5">
      {/* 顶部导航 */}
      <div className="flex items-center justify-between flex-wrap gap-3">
        <div className="text-sm text-slate-400">
          <Link href={`/learn/${lang}`} className="hover:text-slate-600">
            {course.emoji} {course.name}
          </Link>
          <span className="mx-2">/</span>
          <span>
            L{level.id} {level.name}
          </span>
          <span className="mx-2">/</span>
          <span className="text-slate-600">
            {index + 1} / {total}
          </span>
        </div>
        <div className="flex items-center gap-2">
          <button
            onClick={toggleLessonFav}
            title={lessonFav ? "取消收藏本课" : "收藏本课"}
            className={`text-sm font-medium px-3 py-2 rounded-xl border transition-colors ${
              lessonFav
                ? "border-amber-300 bg-amber-50 text-amber-500"
                : "border-border text-slate-400 hover:border-amber-300 hover:text-amber-500"
            }`}
          >
            {lessonFav ? "★ 已收藏" : "☆ 收藏"}
          </button>
          <button
            onClick={markComplete}
            disabled={completed}
            className={`text-sm font-medium px-4 py-2 rounded-xl transition-colors ${
              completed
                ? "bg-emerald-50 text-emerald-600"
                : "bg-emerald-600 hover:bg-emerald-700 text-white"
            }`}
          >
            {completed ? "✓ 已完成" : "标记完成 +10 XP"}
          </button>
        </div>
      </div>

      {justCompleted && (
        <div className="bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm rounded-xl px-4 py-3 flex items-center justify-between">
          <span>🎉 完成本课 +10 XP！建议先做一套测验巩固，再进入下一课。</span>
          {next && (
            <Link
              href={`/learn/${lang}/${next.id}`}
              className="font-medium underline shrink-0 ml-3"
            >
              下一课 →
            </Link>
          )}
        </div>
      )}

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {/* 左列：课程内容 */}
        <div className="space-y-5">
          <header>
            <h1 className="text-2xl font-extrabold">{lesson.title}</h1>
            <p className="text-slate-500 mt-1.5 leading-relaxed">{lesson.summary}</p>
          </header>

          <section className="bg-card border border-border rounded-2xl p-5">
            <h2 className="font-bold mb-3">📌 本课知识点</h2>
            <ul className="space-y-2">
              {lesson.keyPoints.map((kp, i) => {
                const fav = isKeyPointFav(kp);
                return (
                  <li key={i} className="flex gap-2.5 text-sm leading-relaxed items-start">
                    <span className="shrink-0 w-5 h-5 rounded-full bg-indigo-50 text-indigo-600 text-xs grid place-items-center font-bold mt-0.5">
                      {i + 1}
                    </span>
                    <span className="flex-1">{kp}</span>
                    <button
                      onClick={() => toggleKeyPointFav(kp)}
                      title={fav ? "取消收藏该知识点" : "收藏该知识点"}
                      className={`shrink-0 text-xs mt-0.5 transition-colors ${
                        fav ? "text-amber-500" : "text-slate-300 hover:text-amber-400"
                      }`}
                    >
                      {fav ? "★" : "☆"}
                    </button>
                  </li>
                );
              })}
            </ul>
          </section>

          {lesson.example && (
            <section className="bg-card border border-border rounded-2xl p-5">
              <div className="flex items-center justify-between mb-3">
                <h2 className="font-bold">
                  {course.kind === "language" ? "🗣 例句与读音" : "💻 示例代码"}
                </h2>
                {lesson.example.note && (
                  <span className="text-xs text-slate-400">{lesson.example.note}</span>
                )}
              </div>
              {course.kind === "language" ? (
                <div className="whitespace-pre-wrap text-sm leading-loose bg-rose-50/50 border border-rose-100 rounded-xl p-4">
                  {lesson.example.code}
                </div>
              ) : (
                <Markdown content={`\`\`\`${HL_LANG[lang] ?? lang}\n${lesson.example.code}\n\`\`\``} />
              )}
            </section>
          )}

          {/* AI 深入讲解 */}
          <section className="bg-card border border-border rounded-2xl p-5">
            <div className="flex items-center justify-between mb-1">
              <h2 className="font-bold">🤖 AI 深入讲解</h2>
              <div className="flex items-center gap-2">
                {explain && !explaining && (
                  <SpeakButton
                    id={`explain-${lesson.id}`}
                    text={explain}
                  />
                )}
                <button
                  onClick={() => deepExplain(explain ? true : false)}
                  disabled={explaining}
                  title={explain ? "忽略缓存，重新生成讲解" : "优先复用已有讲解，没有才调用 AI"}
                  className="text-sm bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 text-white px-4 py-1.5 rounded-lg transition-colors"
                >
                  {explaining ? "讲解中…" : explain ? "重新讲解" : "开始讲解"}
                </button>
              </div>
            </div>
            {(explainReasoning || explaining) && (
              <ReasoningBlock
                reasoning={explainReasoning}
                thinking={explaining && !explain}
              />
            )}
            {explainError && (
              <p className="text-sm text-red-500 bg-red-50 rounded-lg px-3 py-2 my-2">
                {explainError}
              </p>
            )}
            {explain && (
              <div className="mt-2">
                <Markdown content={explain} />
              </div>
            )}
            {explaining && explain && <span className="streaming-cursor" />}
            {!explain && !explaining && !explainError && !explainReasoning && (
              <p className="text-sm text-slate-400">
                点击「开始讲解」，AI 会用类比、更多例子和常见坑帮你吃透本课。
              </p>
            )}
          </section>

          {/* 我的笔记 */}
          <section className="bg-card border border-border rounded-2xl p-5">
            <div className="flex items-center justify-between mb-2">
              <h2 className="font-bold">📝 我的笔记</h2>
              <div className="flex items-center gap-2">
                {noteSavedAt && (
                  <span className="text-xs text-emerald-500">✓ 已保存 {noteSavedAt}</span>
                )}
                <button
                  onClick={handleSaveNote}
                  className="text-sm bg-slate-800 hover:bg-slate-700 text-white px-3.5 py-1.5 rounded-lg transition-colors"
                >
                  保存笔记
                </button>
              </div>
            </div>
            <textarea
              value={noteDraft}
              onChange={(e) => setNoteDraft(e.target.value)}
              rows={5}
              placeholder="记录你的理解、易错点、心得…（保存在本机，可在「知识库 → 笔记」查看全部）"
              className="w-full text-sm bg-amber-50/40 border border-amber-100 rounded-xl p-3.5 focus:outline-none focus:ring-2 focus:ring-amber-200 focus:border-amber-300 leading-relaxed"
            />
          </section>

          {/* 相关 LeetCode 练习（仅算法类语言） */}
          {LC_LANGS.has(lang) && (
            <section className="bg-card border border-border rounded-2xl p-5">
              <LeetCodeList
                tags={lessonToLcTags(lang, lesson.title, lesson.summary)}
                limit={5}
                title="💻 相关 LeetCode 实战"
              />
            </section>
          )}

          {/* 上一课 / 下一课 */}
          <div className="flex justify-between gap-3 pb-4">
            {prev ? (
              <Link
                href={`/learn/${lang}/${prev.id}`}
                className="text-sm text-slate-500 hover:text-indigo-600 bg-card border border-border rounded-xl px-4 py-2.5"
              >
                ← {prev.title}
              </Link>
            ) : (
              <span />
            )}
            {next ? (
              <Link
                href={`/learn/${lang}/${next.id}`}
                className="text-sm text-slate-500 hover:text-indigo-600 bg-card border border-border rounded-xl px-4 py-2.5 text-right"
              >
                {next.title} →
              </Link>
            ) : (
              <span />
            )}
          </div>
        </div>

        {/* 右列：AI 面板 */}
        <div className="bg-card border border-border rounded-2xl overflow-hidden flex flex-col min-h-[600px] lg:sticky lg:top-20 lg:h-[calc(100vh-6.5rem)]">
          <div className="flex border-b border-border shrink-0">
            {tabBtn("tutor", "💬 AI 导师")}
            {tabBtn("quiz", "📝 练习测验")}
            {tabBtn("review", "🔍 代码审查")}
            {tabBtn("interview", "🎤 模拟面试")}
          </div>
          <div className="flex-1 min-h-0 overflow-y-auto">
            {tab === "tutor" && (
              <ChatPanel lang={lang} langName={course.name} lesson={lesson} />
            )}
            {tab === "quiz" && <QuizTab lang={lang} lesson={lesson} />}
            {tab === "review" && <CodeReview lang={lang} lesson={lesson} />}
            {tab === "interview" && <InterviewTab lang={lang} lesson={lesson} />}
          </div>
        </div>
      </div>
    </div>
  );
}
