"use client";

import type {
  ChatMessage,
  LeetCodeProblem,
  Notebook,
  Progress,
  PublicSettings,
  ProviderId,
} from "@/lib/types";
import { LC_LANGS } from "@/lib/ai/presets";

// ---- Settings ----
export async function fetchSettings(): Promise<PublicSettings> {
  const res = await fetch("/api/settings");
  return res.json();
}

export interface SaveSettingsPayload {
  provider: ProviderId;
  apiKey?: string; // 留空 = 保留旧 Key
  baseUrl?: string;
  model?: string;
  temperature?: number;
}

export async function saveSettings(payload: SaveSettingsPayload) {
  const res = await fetch("/api/settings", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(payload),
  });
  if (!res.ok) throw new Error((await res.json()).error ?? "保存失败");
  return res.json();
}

export interface TestResult {
  ok: boolean;
  error?: string;
  reply?: string;
  model?: string;
}

export async function testSettings(
  payload: SaveSettingsPayload & { persist?: boolean }
): Promise<TestResult> {
  const res = await fetch("/api/settings/test", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(payload),
  });
  return res.json();
}

// ---- Progress ----
export async function fetchProgress(): Promise<Progress> {
  const res = await fetch("/api/progress");
  return res.json();
}

type ProgressOp =
  | { type: "visit"; lessonId: string }
  | { type: "complete"; lessonId: string }
  | { type: "quizResult"; lessonId: string; score: number; wrongIds?: string[] }
  | { type: "interviewResult"; lessonId: string; score: number }
  | { type: "reset" };

export async function postProgress(op: ProgressOp): Promise<Progress> {
  const res = await fetch("/api/progress", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(op),
  });
  return res.json();
}

// ---- Notebook（错题本 / 收藏 / 笔记） ----
