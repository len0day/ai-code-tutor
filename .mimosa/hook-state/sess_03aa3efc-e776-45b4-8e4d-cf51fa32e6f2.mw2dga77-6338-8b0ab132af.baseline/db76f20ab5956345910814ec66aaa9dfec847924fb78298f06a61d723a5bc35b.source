            code: `# test_calc.py  →  运行: pytest -v
import pytest

def add(a, b):
    return a + b

def test_add():
    assert add(2, 3) == 5

def test_add_negative():
    assert add(-1, 1) == 0

@pytest.mark.parametrize("a,b,expect", [
    (1, 2, 3),
    (0, 0, 0),
    (100, 200, 300),
])
def test_many(a, b, expect):
    assert add(a, b) == expect
`,
