          example: {
            code: `from dataclasses import dataclass, asdict
import json, pathlib

@dataclass
class Task:
    id: int
    title: str
    done: bool = False

DB = pathlib.Path.home() / ".todo.json"

def load() -> list[Task]:
    if not DB.exists():
        return []
    return [Task(**t) for t in json.loads(DB.read_text("utf-8"))]

def save(tasks: list[Task]):
    DB.write_text(json.dumps([asdict(t) for t in tasks], ensure_ascii=False), "utf-8")

def add(title: str) -> Task:
    tasks = load()
    task = Task(len(tasks) + 1, title)
    tasks.append(task)
    save(tasks)
    return task

if __name__ == "__main__":
    add("学完 Python 高级课程")
    print([t.title for t in load()])
`,
