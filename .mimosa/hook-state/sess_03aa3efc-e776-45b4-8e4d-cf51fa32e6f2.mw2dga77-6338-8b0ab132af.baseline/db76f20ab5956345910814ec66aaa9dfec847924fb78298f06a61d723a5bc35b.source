            "带参数的装饰器要再包一层",
          ],
          example: {
            code: `import functools, time

def timer(func):
    @functools.wraps(func)
    def wrapper(*args, **kwargs):
        start = time.perf_counter()
        result = func(*args, **kwargs)
        print(f"{func.__name__} 耗时 {time.perf_counter()-start:.4f}s")
        return result
    return wrapper

@timer
def slow_sum():
    return sum(range(1_000_000))

slow_sum()
`,
