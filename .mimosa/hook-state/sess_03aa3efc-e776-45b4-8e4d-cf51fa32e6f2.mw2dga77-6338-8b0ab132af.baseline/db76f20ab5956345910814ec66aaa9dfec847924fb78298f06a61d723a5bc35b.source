            code: `import asyncio

async def fake_fetch(name: str, seconds: float) -> str:
    await asyncio.sleep(seconds)        # 模拟 IO
    return f"{name} 完成"

async def main():
    results = await asyncio.gather(
        fake_fetch("A", 1),
        fake_fetch("B", 2),
        fake_fetch("C", 1.5),
    )
    print(results)      # 总耗时 ≈ 2s 而非 4.5s

asyncio.run(main())
`,
