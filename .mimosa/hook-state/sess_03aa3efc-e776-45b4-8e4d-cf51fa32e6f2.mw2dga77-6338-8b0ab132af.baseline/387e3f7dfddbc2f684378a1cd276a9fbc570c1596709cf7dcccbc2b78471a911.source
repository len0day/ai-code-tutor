          ],
          example: {
            code: `<!-- 危险！用户昵称若为 <img src=x onerror=alert(1)> 就炸了 -->
<div id="nick"></div>
<script>
  const nick = getUserInput();
  // document.getElementById("nick").innerHTML = nick;   ❌
  document.getElementById("nick").textContent = nick;    // ✅
</script>

<a href="https://out.example.com" target="_blank" rel="noopener">外链</a>
`,
          },
        },
        {
          id: "html-4-6",
          title: "综合项目：可访问的注册页",
          summary: "综合 24 课：语义结构 + 表单校验 + 可访问性 + 安全。",
          keyPoints: [
            "语义骨架：main > form > fieldset 分组，label 全覆盖",
            "原生校验（required/pattern）+ JS 兜底提示",
            "autocomplete 属性提升体验（username/new-password）",
            "提交前 JS 做最后清洗，密码框 autocomplete=\"new-password\"",
          ],
          example: {
            code: `<main>
  <form action="/api/register" method="post" novalidate id="reg">
    <fieldset>
      <legend>创建账号</legend>
      <label for="email">邮箱</label>
      <input id="email" name="email" type="email" required autocomplete="username">

      <label for="pwd">密码（至少 8 位，含数字）</label>
      <input id="pwd" name="pwd" type="password" required
             pattern="(?=.*\\d).{8,}" autocomplete="new-password">

      <button type="submit">注册</button>
    </fieldset>
  </form>
</main>

<script>
  document.getElementById("reg").addEventListener("submit", (e) => {
    if (!e.target.checkValidity()) {
      e.preventDefault();
      alert("请检查标红的输入项");
    }
  });
</script>
`,
          },
        },
      ],
    },
  ],
};
