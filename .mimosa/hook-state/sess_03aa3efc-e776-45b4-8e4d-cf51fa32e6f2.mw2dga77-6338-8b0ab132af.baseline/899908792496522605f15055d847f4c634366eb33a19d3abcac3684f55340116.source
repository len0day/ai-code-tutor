          example: {
            code: `#!/bin/bash
set -euo pipefail
REPORT="/var/log/patrol-$(date +%F).log"

section() { echo -e "\\n== $1 ==" | tee -a "$REPORT"; }

section "磁盘"
df -h --output=source,pcent | tail -n +2 | while read -r src pct; do
  used=\${pct//%/}
  [ "$used" -ge 85 ] && echo "⚠️ $src 已用 \${pct}" || echo "✓ $src \${pct}"
done | tee -a "$REPORT"

section "内存"
free -h | tee -a "$REPORT"

section "服务"
for svc in nginx myapp; do
  systemctl is-active --quiet "$svc" \\
    && echo "✓ $svc 运行中" || echo "⛔ $svc 已停止"
done | tee -a "$REPORT"

echo "巡检完成 $(date)" | tee -a "$REPORT"
`,
          },
        },
      ],
    },
  ],
};
