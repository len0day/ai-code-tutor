// -Xms 初始堆  -Xmx 最大堆  -Xss 线程栈  -XX:+PrintGCDetails 打印GC

public class MemoryDemo {
    public static void main(String[] args) {
        Runtime rt = Runtime.getRuntime();
        System.out.printf("最大堆: %dMB, 空闲: %dMB%n",
            rt.maxMemory() / 1024 / 1024,
