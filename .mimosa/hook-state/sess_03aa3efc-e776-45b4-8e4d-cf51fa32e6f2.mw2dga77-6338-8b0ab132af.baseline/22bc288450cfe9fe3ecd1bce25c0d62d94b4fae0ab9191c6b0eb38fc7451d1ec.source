    void fetch() { System.out.println("捡球"); }
}

Animal a = new Dog();   // 多态：父类引用指向子类对象
a.speak();              // 汪汪 —— 调的是子类实现
if (a instanceof Dog d) {   // Java 16+ 模式匹配
    d.fetch();
}
