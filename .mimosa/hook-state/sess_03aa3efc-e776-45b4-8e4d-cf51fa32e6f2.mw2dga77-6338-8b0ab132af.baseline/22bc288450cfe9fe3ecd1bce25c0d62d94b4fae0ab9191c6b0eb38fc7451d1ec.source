          example: {
            code: `interface Flyable {
    void fly();                          // 抽象方法
    default void land() {                // 默认实现
        System.out.println("降落");
    }
}

abstract class Bird {
    abstract String name();
}

class Sparrow extends Bird implements Flyable {
    String name() { return "麻雀"; }
    public void fly() { System.out.println("扑棱扑棱"); }
}

Sparrow sp = new Sparrow();
sp.fly(); sp.land();
`,
