          keyPoints: [
            "record 定义账目记录（不可变数据类，Java 16+）",
            "枚举 Category 约束收支类型，switch 表达式处理命令",
            "Map<String, Double> + Stream 按月汇总统计",
            "CSV 读写持久化，核心方法配 JUnit 测试",
          ],
          example: {
            code: `import java.nio.file.*;
import java.time.LocalDate;
import java.util.*;
import java.util.stream.*;

record Expense(LocalDate date, String category, double amount) { }

public class Ledger {
    static final List<Expense> items = new ArrayList<>();

    static void add(LocalDate d, String cat, double amt) {
        items.add(new Expense(d, cat, amt));
    }

    static Map<String, Double> byCategory() {
        return items.stream().collect(
            Collectors.groupingBy(Expense::category,
                Collectors.summingDouble(Expense::amount)));
    }

    public static void main(String[] args) {
        add(LocalDate.now(), "餐饮", 35.5);
        add(LocalDate.now(), "书籍", 89.0);
        add(LocalDate.now().minusDays(1), "餐饮", 22.0);
        byCategory().forEach((k, v) -> System.out.printf("%s: %.2f%n", k, v));
    }
}
`,
