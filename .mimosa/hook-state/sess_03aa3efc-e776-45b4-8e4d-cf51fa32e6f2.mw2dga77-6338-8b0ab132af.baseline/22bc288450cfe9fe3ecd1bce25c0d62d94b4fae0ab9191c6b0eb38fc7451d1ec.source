          example: {
            code: `import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

class CalcTest {

    @Test
    @DisplayName("加法基础用例")
    void testAdd() {
        assertEquals(3, 1 + 2);
        assertEquals(-1, Integer.MIN_VALUE, "边界");  // 演示
    }

    @Test
    void testDivideByZero() {
        assertThrows(ArithmeticException.class,
            () -> { int x = 1 / 0; });
    }

    @org.junit.jupiter.params.ParameterizedTest
    @org.junit.jupiter.params.provider.CsvSource({"1,2,3", "0,0,0", "10,20,30"})
    void testAddMany(int a, int b, int expect) {
        assertEquals(expect, a + b);
    }
}
