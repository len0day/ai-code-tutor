            code: `import java.util.concurrent.*;

CompletableFuture<String> user =
    CompletableFuture.supplyAsync(() -> "小明");
CompletableFuture<Integer> score =
    CompletableFuture.supplyAsync(() -> 95);

String result = user.thenCombine(score, (u, s) -> u + ":" + s)
                    .join();
System.out.println(result);      // 小明:95

ConcurrentHashMap<String, Integer> map = new ConcurrentHashMap<>();
map.computeIfAbsent("hits", k -> 0);
map.merge("hits", 1, Integer::sum);   // 原子计数
`,
