          example: {
            code: `class Box<T> {
    private T value;
    public void set(T v) { this.value = v; }
    public T get() { return value; }
}

class Util {
    static <T> T firstOrDefault(List<T> list, T def) {
        return list.isEmpty() ? def : list.get(0);
    }
}

Box<String> sb = new Box<>();
sb.set("hello");
System.out.println(sb.get().toUpperCase());  // 无需强转

System.out.println(Util.firstOrDefault(List.of(), "空"));
`,
