Predicate<Integer> isEven = n -> n % 2 == 0;

List<String> names = new ArrayList<>(List.of("张三", "李四", "王五"));
names.sort((a, b) -> a.compareTo(b));    // Lambda 排序
names.sort(Comparator.naturalOrder());   // 等价
task.run();
