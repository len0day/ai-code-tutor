import "server-only";
import { createSqliteDb } from "./sqlite";
import { createPostgresDb } from "./postgres";

/**
 * 数据访问统一接口。
 *
 * 两套实现：
 *  - SQLite（默认，零配置）：Node 22 内置 node:sqlite
 *  - PostgreSQL（生产推荐）：设置环境变量 DATABASE_URL 即自动切换
 *
 * SQL 约定（两端通用）：
 *  - 占位符统一用 `$name` 具名形式 —— SQLite 与 Postgres 均原生支持，对象绑定
 *  - 写入统一用 `INSERT ... ON CONFLICT (...) DO UPDATE`（两端均支持）
 *  - 不使用 INSERT OR REPLACE / AUTOINCREMENT 等方言
 */

export type DbKind = "sqlite" | "postgres";

/** 具名参数表：SQL 中用 $name 引用 */
export type DbParamValue = string | number | bigint | boolean | null | Uint8Array;
export type DbParams = Record<string, DbParamValue>;

export interface Db {
  readonly kind: DbKind;
  /** 执行建表等无参数语句 */
  runRaw(sql: string): Promise<void>;
  /** 查询多行 */
  all<T = Record<string, unknown>>(sql: string, params?: DbParams): Promise<T[]>;
  /** 查询单行（无结果返回 null） */
  get<T = Record<string, unknown>>(sql: string, params?: DbParams): Promise<T | null>;
  /** 执行写入 */
  run(sql: string, params?: DbParams): Promise<void>;
  /** 事务 */
  tx<T>(fn: () => Promise<T>): Promise<T>;
}

/** 表结构（两端通用） */
export const SCHEMA_STATEMENTS: string[] = [
  `CREATE TABLE IF NOT EXISTS users (
    id TEXT PRIMARY KEY,
    username TEXT UNIQUE NOT NULL,
    password_hash TEXT NOT NULL,
    salt TEXT NOT NULL,
    role TEXT NOT NULL DEFAULT 'user',
    disabled INTEGER NOT NULL DEFAULT 0,
    created_at TEXT NOT NULL
  )`,
  `CREATE TABLE IF NOT EXISTS user_progress (
    user_id TEXT NOT NULL,
    lesson_id TEXT NOT NULL,
    completed INTEGER NOT NULL DEFAULT 0,
    quiz_scores TEXT NOT NULL DEFAULT '[]',
    interview_scores TEXT NOT NULL DEFAULT '[]',
    wrong_question_ids TEXT NOT NULL DEFAULT '[]',
    visited_at TEXT,
    completed_at TEXT,
    PRIMARY KEY (user_id, lesson_id)
  )`,
  `CREATE TABLE IF NOT EXISTS user_stats (
    user_id TEXT PRIMARY KEY,
    xp INTEGER NOT NULL DEFAULT 0,
    streak INTEGER NOT NULL DEFAULT 0,
    last_study_date TEXT
  )`,
  `CREATE TABLE IF NOT EXISTS wrong_questions (
    id TEXT NOT NULL,
    user_id TEXT NOT NULL,
    payload TEXT NOT NULL,
    resolved INTEGER NOT NULL DEFAULT 0,
    added_at TEXT NOT NULL,
    PRIMARY KEY (user_id, id)
  )`,
  `CREATE TABLE IF NOT EXISTS favorites (
    id TEXT NOT NULL,
    user_id TEXT NOT NULL,
    payload TEXT NOT NULL,
    added_at TEXT NOT NULL,
    PRIMARY KEY (user_id, id)
  )`,
  `CREATE TABLE IF NOT EXISTS notes (
    user_id TEXT NOT NULL,
    lesson_id TEXT NOT NULL,
    lang TEXT NOT NULL,
    content TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    PRIMARY KEY (user_id, lesson_id)
  )`,
  `CREATE TABLE IF NOT EXISTS memory_chats (
    user_id TEXT NOT NULL,
    lesson_id TEXT NOT NULL,
    messages TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    PRIMARY KEY (user_id, lesson_id)
  )`,
  `CREATE TABLE IF NOT EXISTS settings (
    key TEXT PRIMARY KEY,
    value TEXT NOT NULL
  )`,
  `CREATE TABLE IF NOT EXISTS content_cache (
    cache_key TEXT PRIMARY KEY,
    task TEXT NOT NULL,
    lang TEXT,
    lesson_id TEXT,
    content TEXT NOT NULL,
    created_at TEXT NOT NULL
  )`,
  `CREATE TABLE IF NOT EXISTS ai_usage (
    user_id TEXT NOT NULL,
    date TEXT NOT NULL,
    count INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (user_id, date)
  )`,
  `CREATE TABLE IF NOT EXISTS course_unlocks (
    user_id TEXT NOT NULL,
    lang TEXT NOT NULL,
    unlocked_at TEXT NOT NULL,
    PRIMARY KEY (user_id, lang)
  )`,
  `CREATE TABLE IF NOT EXISTS app_config (
    key TEXT PRIMARY KEY,
    value TEXT NOT NULL
  )`,
  `CREATE TABLE IF NOT EXISTS token_usage (
    id TEXT PRIMARY KEY,
    user_id TEXT NOT NULL,
    task TEXT NOT NULL,
    model TEXT NOT NULL,
    lang TEXT,
    prompt_tokens INTEGER NOT NULL DEFAULT 0,
    completion_tokens INTEGER NOT NULL DEFAULT 0,
    total_tokens INTEGER NOT NULL DEFAULT 0,
    estimated INTEGER NOT NULL DEFAULT 0,
    created_at TEXT NOT NULL
  )`,
  `CREATE TABLE IF NOT EXISTS api_tokens (
    token_hash TEXT PRIMARY KEY,
    user_id TEXT NOT NULL,
    label TEXT NOT NULL DEFAULT '',
    created_at TEXT NOT NULL,
    last_used_at TEXT,
    revoked INTEGER NOT NULL DEFAULT 0
  )`,
  `CREATE TABLE IF NOT EXISTS lesson_gates (
    user_id TEXT NOT NULL,
    lesson_id TEXT NOT NULL,
    quiz_passed INTEGER NOT NULL DEFAULT 0,
    interview_passed INTEGER NOT NULL DEFAULT 0,
    quiz_score INTEGER NOT NULL DEFAULT 0,
    interview_score INTEGER NOT NULL DEFAULT 0,
    attempts INTEGER NOT NULL DEFAULT 0,
    updated_at TEXT NOT NULL,
    PRIMARY KEY (user_id, lesson_id)
  )`,
  `CREATE INDEX IF NOT EXISTS idx_cache_task ON content_cache (task)`,
  `CREATE INDEX IF NOT EXISTS idx_token_usage_date ON ai_usage (date)`,
  `CREATE INDEX IF NOT EXISTS idx_wrong_user ON wrong_questions (user_id)`,
];

let instance: Db | null = null;

/** 获取数据库实例：DATABASE_URL 存在 → PostgreSQL，否则 SQLite */
export async function getDb(): Promise<Db> {
  if (instance) return instance;
  const url = process.env.DATABASE_URL?.trim();
  const created = url ? await createPostgresDb(url) : await createSqliteDb();
  for (const statement of SCHEMA_STATEMENTS) {
    await created.runRaw(statement);
  }
  instance = created;
  return instance;
}
