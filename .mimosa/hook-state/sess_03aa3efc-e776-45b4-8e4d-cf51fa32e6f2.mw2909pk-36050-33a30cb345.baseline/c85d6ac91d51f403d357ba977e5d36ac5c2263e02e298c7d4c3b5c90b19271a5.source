RUN npm ci
COPY . .

# ❌ 坏的顺序（改一行代码就要重装全部依赖）
COPY . .
RUN npm ci
`,
          },
        },
        {
          id: "docker-2-3",
          title: "Dockerfile 指令详解",
          summary: "ENV/ARG/WORKDIR/USER/ENTRYPOINT，把指令用对用好。",
          keyPoints: [
            "ENV 运行时可见，ARG 只在构建期有效（常用于版本号）",
            "ENTRYPOINT 固定主程序，CMD 提供默认参数（两者可组合）",
            "USER 指定运行用户，别用 root 跑业务（安全）",
            "用 exec 形式 CMD [\"node\",\"app.js\"] 保证信号正确传递（可被优雅停止）",
          ],
          example: {
            code: `ARG NODE_VERSION=20
FROM node:\${NODE_VERSION}-alpine

ENV NODE_ENV=production
WORKDIR /app
USER node
ENTRYPOINT ["node"]
CMD ["server.js"]
`,
          },
