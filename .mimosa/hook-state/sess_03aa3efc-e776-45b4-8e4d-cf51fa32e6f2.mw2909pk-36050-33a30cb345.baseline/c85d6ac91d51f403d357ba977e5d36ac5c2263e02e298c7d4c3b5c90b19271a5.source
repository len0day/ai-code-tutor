          keyPoints: [
            "-v 卷名:容器内路径，由 Docker 统一管理（Linux 在 /var/lib/docker/volumes）",
            "bind mount：-v /宿主路径:容器路径，开发时同步代码最常用",
            "volume 生命周期独立于容器，docker volume rm 才删",
            "匿名卷（只写容器路径）不推荐，难管理",
          ],
          example: {
            code: `# 具名卷：数据安全，删容器数据还在
