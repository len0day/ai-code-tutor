            "Promise 三状态：pending → fulfilled / rejected，一经改变不可逆",
            ".then(成功).catch(失败).finally(收尾) 链式写法",
          ],
          example: {
            code: `function wait(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

wait(1000)
  .then(() => { console.log("1秒后"); return wait(500); })
  .then(() => console.log("再过0.5秒"))
  .catch(err => console.error("出错了", err))
  .finally(() => console.log("收尾"));

Promise.all([wait(100), wait(200)])   // 全部完成
  .then(() => console.log("全部完成"));
`,
          },
        },
        {
          id: "js-3-2",
          title: "async / await 与错误处理",
          summary: "用同步的写法做异步的事，try/catch 管住所有错误。",
          keyPoints: [
            "async 函数自动返回 Promise，await 后面跟 Promise 等结果",
            "await 只能出现在 async 函数（或模块顶层）中",
            "错误处理：try { await ... } catch (e)，比 .then 链直观得多",
            "多个无依赖任务用 Promise.all 并发，串行 await 会白白变慢",
          ],
          example: {
            code: `async function getUser(id) {
  const res = await fetch(\`/api/users/\${id}\`);
  if (!res.ok) throw new Error(\`HTTP \${res.status}\`);
  return res.json();
}

async function main() {
  try {
    const [user, orders] = await Promise.all([
      getUser(1),            // 并发，总耗时≈最慢的那个
      getUser(2),
    ]);
    console.log(user, orders);
  } catch (err) {
    console.error("加载失败:", err.message);
  }
}
main();
`,
          },
        },
        {
          id: "js-3-3",
