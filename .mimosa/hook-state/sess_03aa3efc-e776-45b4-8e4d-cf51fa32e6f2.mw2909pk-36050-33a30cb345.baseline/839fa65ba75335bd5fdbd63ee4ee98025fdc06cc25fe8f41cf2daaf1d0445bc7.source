          keyPoints: [
            "可迭代协议：对象实现 [Symbol.iterator]() 返回带 next() 的迭代器",
            "function* 生成器函数，yield 交出值并暂停，next() 续跑",
            "yield* 委托另一个生成器；生成器可双向通信（next(value)）",
            "应用：惰性序列、状态机、配合 co/redux-saga 做异步流程控制",
          ],
          example: {
            code: `function* fibonacci() {
  let [a, b] = [0, 1];
  while (true) {
    yield a;
    [a, b] = [b, a + b];
  }
}

const fib = fibonacci();
console.log([fib.next().value, fib.next().value, fib.next().value]); // 0 1 1

for (const n of fibonacci()) {
  if (n > 50) break;
  console.log(n);        // for...of 直接消费生成器
}
`,
          },
        },
        {
          id: "js-4-3",
          title: "Proxy / Reflect 与元编程",
          summary: "Proxy 可以拦截对象的一切操作，Vue3 响应式的基石。",
          keyPoints: [
            "new Proxy(target, handler) 代理对象，get/set/has/deleteProperty 等钩子",
            "Reflect 与 Proxy 钩子一一对应，是执行默认行为的规范方式",
            "用 get/set 拦截即可实现简易响应式（依赖收集简化版）",
            "应用：响应式框架、数据校验、日志埋点、API mock",
          ],
          example: {
            code: `function reactive(obj) {
  return new Proxy(obj, {
    get(target, key) {
      console.log(\`读取 \${String(key)}\`);
      return Reflect.get(target, key);
    },
    set(target, key, value) {
      console.log(\`设置 \${String(key)} = \${value}\`);
      Reflect.set(target, key, value);
      return true;
    },
  });
}

const state = reactive({ count: 0 });
state.count++;        // 触发 get 和 set
`,
          },
        },
        {
          id: "js-4-4",
          title: "内存管理与常见泄漏",
          summary: "GC 自动回收不可达对象，泄漏的根源都是「不该活的还被引用着」。",
          keyPoints: [
            "GC 按可达性回收：从根（全局/栈）出发找不到的就回收",
            "泄漏三兄弟：被遗忘的定时器、闭包持有大对象、脱离 DOM 的引用",
            "addEventListener 配 removeEventListener，组件卸载要清理",
            "WeakMap/WeakSet 弱引用不阻止回收，适合做缓存和元数据",
          ],
          example: {
            code: `const cache = new Map();          // 强引用，键对象永不回收
const meta = new WeakMap();       // 弱引用，元素删除后可被 GC

function track(el) {
  meta.set(el, { visits: (meta.get(el)?.visits ?? 0) + 1 });
}

let timerId = null;
function startPolling(fn) {
  timerId = setInterval(fn, 1000);
}
function stopPolling() {
  clearInterval(timerId);         // 忘了这行就是泄漏
  timerId = null;
}
`,
          },
        },
        {
          id: "js-4-5",
          title: "函数式编程思想",
          summary: "纯函数 + 不可变数据 + 组合，让复杂逻辑变得可推理可测试。",
          keyPoints: [
            "纯函数：相同输入必相同输出，无副作用 → 好测好缓存",
            "不可变：改数据生成新对象（[...arr]、{...obj}），不原地改",
            "高阶组合 pipe = (...fns) => x => fns.reduce((v, f) => f(v), x)",
            "避免共享可变状态，React/Redux 的核心设计都源于此",
          ],
          example: {
            code: `const pipe = (...fns) => (x) => fns.reduce((v, f) => f(v), x);

const trim = (s) => s.trim();
const lower = (s) => s.toLowerCase();
const slugify = (s) => s.replace(/\\s+/g, "-");

const slug = pipe(trim, lower, slugify);
console.log(slug("  Hello World  "));   // "hello-world"

// 不可变更新
const todos = [{ id: 1, done: false }];
const toggled = todos.map(t => t.id === 1 ? { ...t, done: true } : t);
`,
          },
        },
        {
          id: "js-4-6",
          title: "综合项目：待办清单应用",
          summary: "综合运用 23 课知识：状态管理 + 事件委托 + localStorage 持久化。",
          keyPoints: [
            "状态与视图分离：state 数组是唯一数据源，render 全量重绘",
            "事件委托处理增删改，data-* 属性携带元素身份",
            "localStorage + JSON.stringify 持久化，刷新不丢数据",
            "防抖优化输入，filter/map 计算未完成数",
          ],
          example: {
            code: `const KEY = "todos";
let state = JSON.parse(localStorage.getItem(KEY) || "[]");

function save() { localStorage.setItem(KEY, JSON.stringify(state)); }

function render() {
  const list = document.querySelector("#list");
  list.innerHTML = "";
  state.forEach(todo => {
    const li = document.createElement("li");
    li.dataset.id = todo.id;
    li.textContent = todo.text;
    li.className = todo.done ? "done" : "";
    list.appendChild(li);
  });
}

document.querySelector("#form").addEventListener("submit", (e) => {
  e.preventDefault();
  const input = document.querySelector("#input");
  if (!input.value.trim()) return;
  state.push({ id: Date.now(), text: input.value, done: false });
  input.value = "";
  save(); render();
});

// 事件委托切换完成状态
document.querySelector("#list").addEventListener("click", (e) => {
  const id = Number(e.target.dataset.id);
  state = state.map(t => t.id === id ? { ...t, done: !t.done } : t);
  save(); render();
});
render();
`,
          },
        },
      ],
    },
  ],
};
