          keyPoints: [
            "永远用 === 严格相等（不转类型），== 会隐式转换尽量避免",
            "假值只有 6 个：false、0、\"\"、null、undefined、NaN",
            "转数字 Number(\"42\")、转字符串 String(42)、转布尔 Boolean(x)",
            "?? 空值合并：a ?? b 仅在 a 为 null/undefined 时取 b",
          ],
          example: {
            code: `console.log(1 == "1");    // true  （转换后比较）
console.log(1 === "1");   // false （类型不同直接不等）
console.log(null == undefined);  // true
console.log(NaN === NaN);        // false！判断用 Number.isNaN

console.log(Boolean(""));       // false
console.log("" || "默认");      // "默认"
console.log(0 ?? "默认");       // 0 —— ?? 只认 null/undefined
console.log(null ?? "默认");    // "默认"
`,
          },
        },
        {
