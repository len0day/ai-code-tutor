  console.log(\`第\${i + 1}个及格: \${scores[i]}\`);
}

for (const s of scores) console.log(s);     // 值
for (const k in { a: 1, b: 2 }) console.log(k);  // 键 "a" "b"

scores.forEach((s, i) => console.log(i, s));
`,
          },
        },
