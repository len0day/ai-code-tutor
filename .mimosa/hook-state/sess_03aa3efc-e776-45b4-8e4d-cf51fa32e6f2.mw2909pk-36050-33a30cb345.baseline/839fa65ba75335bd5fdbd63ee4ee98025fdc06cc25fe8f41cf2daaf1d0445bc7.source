const evens = nums.filter(n => n % 2 === 0); // [2,4,6]
const total = nums.reduce((a, b) => a + b, 0); // 21

const users = [
  { name: "小明", score: 88 },
  { name: "小红", score: 55 },
];
const passed = users.filter(u => u.score >= 60).map(u => u.name);
console.log(passed);   // ["小明"]
