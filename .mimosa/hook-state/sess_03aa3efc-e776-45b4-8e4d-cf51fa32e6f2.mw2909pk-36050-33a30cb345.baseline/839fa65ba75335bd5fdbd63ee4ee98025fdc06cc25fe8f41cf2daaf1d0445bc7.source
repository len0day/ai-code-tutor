            "箭头函数 () => {} 简洁，单表达式可省 return",
            "参数可设默认值 function f(x = 1)，剩余参数 ...rest 收集成数组",
            "函数是值，可以存变量、当参数、当返回值（高阶函数）",
          ],
          example: {
            code: `function add(a, b = 1) {       // 声明式 + 默认参数
  return a + b;
}

const square = (x) => x * x;   // 箭头函数
const sum = (...nums) => nums.reduce((a, b) => a + b, 0);

console.log(add(2));        // 3
console.log(square(5));     // 25
console.log(sum(1, 2, 3));  // 6

setTimeout(() => console.log("3 秒后执行"), 3000);
`,
          },
