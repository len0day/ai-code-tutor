          ],
          example: {
            code: `function makeCounter() {
  let count = 0;              // 被闭包捕获的私有变量
  return {
    inc: () => ++count,
    get: () => count,
  };
}
const c = makeCounter();
c.inc(); c.inc();
console.log(c.get());   // 2，外部无法直接改 count

// 经典面试题
for (var i = 0; i < 3; i++) setTimeout(() => console.log("var:", i));
for (let j = 0; j < 3; j++) setTimeout(() => console.log("let:", j));
// var: 3 3 3   let: 0 1 2
`,
