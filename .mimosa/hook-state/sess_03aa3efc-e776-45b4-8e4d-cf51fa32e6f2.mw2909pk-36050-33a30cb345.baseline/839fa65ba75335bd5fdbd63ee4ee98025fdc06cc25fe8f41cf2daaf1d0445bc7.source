          keyPoints: [
            "this 由调用方式决定：obj.fn() 指向 obj，独立调用指向 undefined（严格模式）",
            "箭头函数没有自己的 this，继承定义处的外层 this（回调救星）",
            "call / apply / bind 显式绑定 this",
            "每个对象有 __proto__，属性沿原型链向上查找直到 null",
          ],
          example: {
            code: `const timer = {
  seconds: 0,
  start() {
    // 箭头函数继承 start 的 this
    setInterval(() => {
      this.seconds++;
      console.log(this.seconds);
    }, 1000);
  },
};

const animal = { kind: "猫" };
function say(name) { console.log(\`\${this.kind}说: \${name}\`); }
say.call(animal, "喵");     // this=animal
`,
          },
