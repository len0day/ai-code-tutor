import type { Course, LangId, Lesson, Level } from "@/lib/types";
import { pythonCourse } from "./python";
import { javaCourse } from "./java";
import { javascriptCourse } from "./javascript";
import { typescriptCourse } from "./typescript";
import { htmlCourse } from "./html";
import { dockerCourse } from "./docker";
import { linuxCourse } from "./linux";
import { japaneseCourse } from "./japanese";

export const COURSES: Course[] = [
  pythonCourse,
  javaCourse,
  javascriptCourse,
  typescriptCourse,
  htmlCourse,
  dockerCourse,
  linuxCourse,
  japaneseCourse,
];

/** 编程与运维课程（/learn 路径） */
export const CODE_COURSES = COURSES.filter((c) => c.kind !== "language");
/** 语言学习增值包课程（/languages 路径） */
export const LANGUAGE_COURSES = COURSES.filter((c) => c.kind === "language");

export const LANG_IDS: LangId[] = [
  "python",
  "java",
  "javascript",
  "typescript",
  "html",
  "docker",
  "linux",
  "japanese",
];

export function getCourse(lang: string): Course | undefined {
  return COURSES.find((c) => c.lang === lang);
}

export function getLevels(lang: string): Level[] {
  return getCourse(lang)?.levels ?? [];
}

/** 扁平化课程列表（含层级信息） */
export function flatLessons(lang: string): Array<{ lesson: Lesson; level: Level }> {
  const out: Array<{ lesson: Lesson; level: Level }> = [];
  for (const level of getLevels(lang)) {
    for (const lesson of level.lessons) out.push({ lesson, level });
  }
  return out;
}

export function findLesson(
  lang: string,
  lessonId: string
): { lesson: Lesson; level: Level; index: number; total: number } | undefined {
  const flat = flatLessons(lang);
  const index = flat.findIndex((x) => x.lesson.id === lessonId);
  if (index === -1) return undefined;
  return {
    lesson: flat[index].lesson,
    level: flat[index].level,
    index,
    total: flat.length,
  };
}

export function totalLessonCount(): number {
  return COURSES.reduce((n, c) => n + c.levels.reduce((m, l) => m + l.lessons.length, 0), 0);
}
